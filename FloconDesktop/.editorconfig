root = true

[*.{kt,kts}]
ktlint_code_style = intellij_idea
indent_size = 4
indent_style = space
insert_final_newline = true
ktlint_custom-rule-set = enabled
ktlint_standard_wrapping = enabled
ktlint_standard_comment-position = disabled
ktlint_standard_-value-parameter-comment = disabled
ktlint_standard_trailing-comma-on-call-site = disabled
ktlint_standard_comment-wrapping = disabled
ktlint_standard_trailing-comma-on-declaration-site = disabled
ktlint_standard_argument-list-wrapping = disabled
ktlint_standard_max-line-length = disabled
ktlint_standard_multiline-if-else = disabled
ktlint_standard_package-name = disabled
ktlint_standard_enum-entry-name-case = disabled
ktlint_standard_kdoc-wrapping = disabled
ktlint_standard_class-naming = disabled
ktlint_compose_modifier-missing-check = disabled
ktlint_compose_param-order-check = disabled
ktlint_compose_modifier-reused-check = disabled
ktlint_compose_compositionlocal-allowlist = disabled
ktlint_compose_preview-public-check = enabled
ktlint_compose_naming-check = disabled
ktlint_compose_parameter-naming = disabled
ktlint_compose_lambda-param-event-trailing = disabled
ktlint_compose_state-param-check = disabled
ktlint_compose_remember-missing-check = disabled
ktlint_compose_multiple-emitters-check = disabled
ktlint_compose_modifier-composed-check = disabled
ktlint_compose_mutable-state-autoboxing = disabled
ktlint_compose_modifier-clickable-order = disabled
ktlint_compose_lambda-param-in-effect = disabled
ktlint_compose_content-slot-reused = disabled
ktlint_standard_property-naming = disabled
ktlint_standard_no-empty-file = disabled
ktlint_standard_filename = disabled
ktlint_function_naming_ignore_when_annotated_with = Composable

[**/build/**/*.kt]
ktlint = disabled
