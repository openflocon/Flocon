{
  "name": "flocon-proxy",
  "private": true,
  "type": "module",
  "dependencies": {
    "mockttp": "^3.15.0"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "scripts": {
    "dev": "bun run src/index.ts --port 8080 --ca-dir ./.ca",
    "build:macos-arm64": "bun build src/index.ts --compile --minify --target=bun-darwin-arm64 --outfile ../composeApp/appResources/macos-arm64/flocon-proxy",
    "build:macos-x64": "bun build src/index.ts --compile --minify --target=bun-darwin-x64 --outfile ../composeApp/appResources/macos-x64/flocon-proxy",
    "build:windows": "bun build src/index.ts --compile --minify --target=bun-windows-x64 --outfile ../composeApp/appResources/windows-x64/flocon-proxy.exe",
    "build:linux": "bun build src/index.ts --compile --minify --target=bun-linux-x64 --outfile ../composeApp/appResources/linux-x64/flocon-proxy",
    "build:all": "bun run build:macos-arm64 && bun run build:macos-x64 && bun run build:windows && bun run build:linux"
  }
}
