#
# Linux (Linuxbrew) formula. macOS is installed with the cask (Casks/flocon.rb).
# The portable uber jar is used instead of the .deb/.rpm: it is a single file,
# needs no ar/tar extraction and no root, and Homebrew provides the JDK.
# The jar is built per CPU architecture (it embeds the native Skia libraries).
class Flocon < Formula
  desc "Desktop companion to inspect and debug Android and Kotlin Multiplatform apps"
  homepage "https://openflocon.github.io/Flocon/"
  version "__VERSION__"
  license "MIT"

  depends_on :linux
  depends_on "openjdk@21"

  on_linux do
    on_intel do
      url "https://github.com/openflocon/Flocon/releases/download/__VERSION__/Flocon-linux-x64.jar"
      sha256 "__SHA256_LINUX_X64__"
    end
    on_arm do
      url "https://github.com/openflocon/Flocon/releases/download/__VERSION__/Flocon-linux-arm64.jar"
      sha256 "__SHA256_LINUX_ARM64__"
    end
  end

  livecheck do
    url :stable
    strategy :github_latest
  end

  def install
    jar = Dir["*.jar"].first
    odie "Flocon jar not found" if jar.nil?
    libexec.install jar => "flocon.jar"
    bin.write_jar_script libexec/"flocon.jar", "flocon", java_version: "21"
  end

  def caveats
    <<~EOS
      Flocon uses adb for Android screenshots, screen recordings and deeplinks.
      The Homebrew android-platform-tools cask is macOS only: install adb with
      your distribution instead, for example:
        sudo apt install android-tools-adb   # Debian / Ubuntu
        sudo dnf install android-tools       # Fedora

      Flocon is a desktop application: it needs a graphical session (X11 or Wayland).
      Start it with:
        flocon
    EOS
  end

  test do
    assert_path_exists libexec/"flocon.jar"
    assert_match "flocon.jar", (bin/"flocon").read
  end
end
