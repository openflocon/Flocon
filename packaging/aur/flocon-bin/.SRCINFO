pkgbase = flocon-bin
	pkgdesc = Desktop debugger for mobile apps (network, databases, analytics, ...) for Android, iOS and KMP
	pkgver = 1.0.0
	pkgrel = 1
	url = https://github.com/openflocon/Flocon
	arch = x86_64
	arch = aarch64
	license = MIT
	depends = alsa-lib
	depends = fontconfig
	depends = freetype2
	depends = glibc
	depends = libx11
	depends = libxext
	depends = libxi
	depends = libxrender
	depends = libxtst
	depends = zlib
	depends = hicolor-icon-theme
	optdepends = android-tools: adb, needed for Android screenshots, screen recordings and deeplinks
	optdepends = xdg-utils: open the Flocon folder and links from the app
	provides = flocon
	conflicts = flocon
	options = !strip
	options = !debug
	noextract = Flocon-1.0.0-x86_64.deb
	noextract = Flocon-1.0.0-aarch64.deb
	source = LICENSE::https://raw.githubusercontent.com/openflocon/Flocon/1.0.0/LICENSE
	sha256sums = SKIP
	source_x86_64 = Flocon-1.0.0-x86_64.deb::https://github.com/openflocon/Flocon/releases/download/1.0.0/Flocon-linux-x64.deb
	sha256sums_x86_64 = SKIP
	source_aarch64 = Flocon-1.0.0-aarch64.deb::https://github.com/openflocon/Flocon/releases/download/1.0.0/Flocon-linux-arm64.deb
	sha256sums_aarch64 = SKIP

pkgname = flocon-bin
